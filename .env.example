# Kalshi API Credentials
# Key ID (UUID) assigned in the Kalshi dashboard (Account > API Keys)
KALSHI_API_KEY_ID=your-key-uuid-here

# Private key: path to private key file (e.g. ./kalshi.key) or inline PEM
KALSHI_PRIVATE_KEY=./kalshi.key

# Optional runtime controls
# MAX_MARKETS=50
# MOCK=false
# RUST_LOG=info

